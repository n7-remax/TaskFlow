{
  "name": "taskflow",
  "private": true,
  "description": "TaskFlow — a Trello-style project management app built with Next.js, Redux Toolkit, Express and Prisma.",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @taskflow/api db:seed"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@taskflow/config": "workspace:*",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
